<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Version>1.3.2.0</Version>
		<LangVersion>preview</LangVersion>

		<Author>Lizvik</Author>
		<Name>Visland</Name>
		<InternalName>visland</InternalName>
		<Tags>island-sanctuary;gathering;workshop</Tags>
		<CategoryTags>utility</CategoryTags>
		<Punchline>Automate island sanctuary activities</Punchline>
		<Description>Automate gathering, workshop assignments, etc.</Description>
		<RepoUrl>https://github.com/lizvik/ffxiv_visland</RepoUrl>
		<IconUrl>https://raw.githubusercontent.com/lizvik/ffxiv_visland/master/icon.png</IconUrl>
	</PropertyGroup>

	<PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))'">
		<DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="croizat.clib" Version="1.0.104" />
		<ProjectReference Include="..\ECommons\ECommons\ECommons.csproj" />
		<EmbeddedResource Include="Localization\*.json" LogicalName="visland.Localization.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Workshop\Data\workshop-seasons.json" LogicalName="visland.Workshop.Data.workshop-seasons.json" />
	</ItemGroup>
</Project>
